# systémové soubory macOS
.DS_Store

# originální fotky – web používá jen upravené verze v Obrazky/web a loga v Obrazky/Logo
/Obrazky/*
!/Obrazky/web/
!/Obrazky/Logo/
# zdrojová loga od grafika – web je nepoužívá (používá logo-dragoun*.svg), zůstávají jen v počítači
/Obrazky/Logo/podlahy logo 2026.*

# interní podklady (zadání a deník úprav) – nejsou součástí webu
/instrukce.md
/stav.md
