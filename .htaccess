# ==========================================================================
# Podlahářství Dragoun – .htaccess
# Přesměrování http → https řeší hosting, zde se neřeší.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# --- Vlastní chybová stránka ---------------------------------------------
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Přesměrování stránek původního webu (Antee, 2026) na sekce nového webu
  # Cíl je absolutní, aby i adresa s www skončila jedním skokem. NE = znak # se nepřekóduje
  # na %23, takže kotva funguje. QSD zahodí starý query string (?nid=…).
  RewriteRule ^kontakt/?$ https://podlaharstvi-dragoun.cz/#kontakt [NC,NE,QSD,R=301,L]
  RewriteRule ^poptavka/?$ https://podlaharstvi-dragoun.cz/#poptavka [NC,NE,QSD,R=301,L]
  RewriteRule ^fotogalerie(/.*)?$ https://podlaharstvi-dragoun.cz/#realizace [NC,NE,QSD,R=301,L]
  RewriteRule ^mapa-stranek/?$ https://podlaharstvi-dragoun.cz/ [NC,QSD,R=301,L]
  # systémové adresy starého redakčního systému (index.php?nid=…, image.php, style.php)
  RewriteRule ^(index|image|style)\.php$ https://podlaharstvi-dragoun.cz/ [NC,QSD,R=301,L]

  # --- Přesměrování www → bez www (kanonická URL https://podlaharstvi-dragoun.cz/)
  RewriteCond %{HTTP_HOST} ^www\.podlaharstvi-dragoun\.cz$ [NC]
  RewriteRule ^(.*)$ https://podlaharstvi-dragoun.cz/$1 [R=301,L]
</IfModule>

# --- Bezpečnostní hlavičky -----------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # CSP: vše z vlastní domény, formulář odesílá na Formspree
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>
ServerSignature Off

# --- Zákaz přístupu k pracovním a skrytým souborům -----------------------
<FilesMatch "(^\.|\.(md|bak|log|sh|py)$)">
  Require all denied
</FilesMatch>

# --- Typy souborů ----------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType text/plain .txt
</IfModule>

# --- Komprese --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml application/manifest+json image/svg+xml
</IfModule>

# --- Cache -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # novější Apache posílá JS jako text/javascript
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
